{
  "name": "pickylibrary",
  "version": "0.2.0",
  "description": "Accessible, themeable Vue 3 base components. Bring your own icons, style it with CSS variables.",
  "license": "MIT",
  "author": "Jochum <jochumjurre@protonmail.com>",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "API.md",
    "STYLING.md",
    "ARCHITECTURE.md"
  ],
  "main": "./dist/pickylibrary.js",
  "module": "./dist/pickylibrary.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pickylibrary.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run verify",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm --prefix example run typecheck",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "verify:all": "npm run verify && npm run test:browser"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.8.7",
    "lightningcss": "^1.30.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.1",
    "vue": "^3.5.30",
    "vue-tsc": "^3.3.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "accessible",
    "a11y",
    "design-system",
    "themeable"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jochumjurre/PickyLibrary.git"
  },
  "homepage": "https://github.com/jochumjurre/PickyLibrary#readme",
  "bugs": {
    "url": "https://github.com/jochumjurre/PickyLibrary/issues"
  }
}
